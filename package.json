    "server-only": "0.0.1",
    "shadcn": "4.16.2",
    "sharp": "0.35.3",
    "tailwind-merge": "3.6.0",
    "tw-animate-css": "1.4.0",
    "y-protocols": "1.0.7",
    "yjs": "13.6.32",
