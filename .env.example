# Local development values. Use separate Netlify scopes for deploy previews and production.
APP_ENV=local
SITE_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=https://example.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=replace-with-local-publishable-key
SUPABASE_SERVICE_ROLE_KEY=replace-with-local-service-role-key
OPENAI_API_KEY=replace-with-local-openai-key
# Deterministic by default. Enable only in a server-only preview context after
# configuring a real credential and completing the model evaluation gate.
THINKING_CANVAS_AI_GATEWAY=fake
OPENAI_RESPONSES_MODEL=gpt-5.6-terra
OPENAI_RESPONSES_TIMEOUT_MS=45000
OPENAI_RESPONSES_MAX_OUTPUT_TOKENS=4000
